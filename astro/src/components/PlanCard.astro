---
import type { Plan } from '../data/planes';
import { contact } from '../data/site';

interface Props {
  plan: Plan;
  featured?: boolean;
}

const { plan, featured = false } = Astro.props;
---

<article class:list={['plan-card', { 'plan-card--featured': featured }]}>
  <div class="plan-header">
    <span class="plan-code">{plan.PLAN}</span>
    <h3 class="plan-name">{plan.DESCRIP}</h3>
  </div>
  <div class="plan-body">
    <p class="plan-text">
      Cobertura de sepelio para vos y tu grupo familiar. Consultá por
      condiciones, alcance y formas de pago.
    </p>
    <a
      href={contact.whatsapp}
      target="_blank"
      rel="noopener"
      class="btn btn--tostado plan-btn"
    >
      Consultar
    </a>
  </div>
</article>

<style>
  .plan-card {
    background: var(--color-oliva);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    color: var(--color-crema);
    box-shadow: 0 8px 24px rgba(17, 17, 17, 0.1);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .plan-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(17, 17, 17, 0.18);
  }

  .plan-card--featured {
    background: var(--color-verde-oscuro);
  }

  .plan-header {
    padding: 1.25rem 1.5rem;
    background: rgba(0, 0, 0, 0.12);
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .plan-code {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    background: var(--color-tostado);
    color: var(--color-nav-texto);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
  }

  .plan-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-crema);
  }

  .plan-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    flex: 1;
  }

  .plan-text {
    font-size: 0.95rem;
    flex: 1;
  }

  .plan-btn {
    align-self: flex-start;
    padding: 0.6rem 1.8rem;
  }
</style>
