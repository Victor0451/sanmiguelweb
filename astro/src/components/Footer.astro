---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import { site, contact, social } from '../data/site';
---

<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-col footer-brand">
      <Image src={logo} alt="" width={72} height={72} />
      <p class="footer-name">{site.name}</p>
      <div class="footer-social">
        <a href={social.facebook} target="_blank" rel="noopener" aria-label="Facebook">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.5 1.6-1.5h1.3V4.9c-.3 0-1.1-.1-2-.1-2 0-3.4 1.2-3.4 3.5V11H8.5v3h2.5v7h2.5z"/></svg>
        </a>
        <a href={social.instagram} target="_blank" rel="noopener" aria-label="Instagram">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M12 8.8a3.2 3.2 0 1 0 0 6.4 3.2 3.2 0 0 0 0-6.4zm0 5.3a2.1 2.1 0 1 1 0-4.2 2.1 2.1 0 0 1 0 4.2zM15.8 8.1a.8.8 0 1 1-1.5 0 .8.8 0 0 1 1.5 0zM12 6.4c1.9 0 2.1 0 2.9.1.7 0 1.1.2 1.3.3.3.1.5.3.7.5.2.2.4.4.5.7.1.2.3.6.3 1.3.1.8.1 1 .1 2.9s0 2.1-.1 2.9c0 .7-.2 1.1-.3 1.3-.1.3-.3.5-.5.7-.2.2-.4.4-.7.5-.2.1-.6.3-1.3.3-.8.1-1 .1-2.9.1s-2.1 0-2.9-.1c-.7 0-1.1-.2-1.3-.3-.3-.1-.5-.3-.7-.5-.2-.2-.4-.4-.5-.7-.1-.2-.3-.6-.3-1.3C6.4 14.1 6.4 13.9 6.4 12s0-2.1.1-2.9c0-.7.2-1.1.3-1.3.1-.3.3-.5.5-.7.2-.2.4-.4.7-.5.2-.1.6-.3 1.3-.3C9.9 6.4 10.1 6.4 12 6.4zm5.5 9.9c.3-.8.2-2.5.1-3.4v-2c.1-1 .2-2.6-.1-3.4-.3-.8-1-1.5-1.9-1.8-.8-.3-2.4-.2-3.4-.1h-2c-1-.1-2.6-.2-3.4.1-.8.3-1.5 1-1.8 1.9-.3.8-.2 2.4-.1 3.4v2c-.1 1-.2 2.6.1 3.4.3.8 1 1.5 1.9 1.8.8.3 2.4.2 3.4.1h2c1 .1 2.6.2 3.4-.1.8-.3 1.5-1 1.8-1.9zM12 4.9c-1.9 0-2.2 0-3 .1-.9 0-1.6.2-2.2.4-.7.2-1.3.6-1.8 1.2C4.4 7.1 4 7.7 3.8 8.4c-.2.6-.4 1.3-.4 2.2-.1.8-.1 1.1-.1 3s0 2.2.1 3c0 .9.2 1.6.4 2.2.2.7.6 1.3 1.2 1.8.5.6 1.1 1 1.8 1.2.6.2 1.3.4 2.2.4.8.1 1.1.1 3 .1s2.2 0 3-.1c.9 0 1.6-.2 2.2-.4.7-.2 1.3-.6 1.8-1.2.6-.5 1-1.1 1.2-1.8.2-.6.4-1.3.4-2.2.1-.8.1-1.1.1-3s0-2.2-.1-3c0-.9-.2-1.6-.4-2.2-.2-.7-.6-1.3-1.2-1.8-.5-.6-1.1-1-1.8-1.2-.6-.2-1.3-.4-2.2-.4-.8-.1-1.1-.1-3-.1z"/></svg>
        </a>
      </div>
    </div>

    <div class="footer-col">
      <h3 class="footer-heading">Contacto</h3>
      <ul class="footer-list">
        <li>
          <a href={`tel:${contact.phoneHref}`}>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
            {contact.phoneDisplay}
          </a>
        </li>
        <li>
          <a href={`mailto:${contact.email}`}>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>
            {contact.email}
          </a>
        </li>
        <li>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
          {contact.address.display}
        </li>
        <li>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm4.2 14.2L11 13V7h1.5v5.2l4.5 2.7z"/></svg>
          {contact.hours}
        </li>
      </ul>
    </div>

    <div class="footer-col">
      <h3 class="footer-heading">Navegación</h3>
      <ul class="footer-list">
        <li><a href="/">Inicio</a></li>
        <li><a href="#nosotros">Nosotros</a></li>
        <li><a href="#servicios">Servicios</a></li>
        <li><a href="#contacto">Contacto</a></li>
        <li><a href={contact.whatsapp} target="_blank" rel="noopener">WhatsApp</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} {site.legalName}. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-tostado);
    color: var(--color-oliva-texto);
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 1.4fr 0.8fr;
    gap: 2.5rem;
    padding-block: 3rem 2rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .footer-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-verde-oscuro);
  }

  .footer-social {
    display: flex;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .footer-social a {
    color: var(--color-verde-oscuro);
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    transition: background-color 0.2s ease;
  }

  .footer-social a:hover,
  .footer-social a:focus-visible {
    background: #ffffff;
  }

  .footer-heading {
    color: var(--color-verde-oscuro);
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1rem;
  }

  .footer-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .footer-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-list a {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-list a:hover,
  .footer-list a:focus-visible {
    color: var(--color-verde-oscuro);
    text-decoration: underline;
  }

  .footer-bottom {
    border-top: 1px solid rgba(126, 129, 107, 0.35);
    padding-block: 1rem;
    text-align: center;
    font-size: 0.85rem;
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
