---
import { Image } from 'astro:assets';
import heroImg from '../assets/images/hero.jpg';
import { site, contact } from '../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-media">
    <Image
      src={heroImg}
      alt="Sala velatoria de San Miguel Sepelios"
      width={2212}
      height={1000}
      quality={82}
      fetchpriority="high"
    />
  </div>

  <div class="container">
    <div class="hero-card">
      <h1 id="hero-title" class="u-title hero-title">SAN MIGUEL</h1>
      <p class="hero-tagline">{site.description}</p>
      <div class="hero-actions">
        <a href="#contacto" class="btn btn--tostado">Contactanos</a>
        <a href={`tel:${contact.phoneHref}`} class="btn btn--outline">Llamanos</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-fondo-suave);
    padding-bottom: 3rem;
  }

  .hero-media img {
    width: 100%;
    height: clamp(260px, 46vw, 560px);
    object-fit: cover;
  }

  .hero-card {
    background: var(--color-crema);
    max-width: 860px;
    margin: -90px auto 0;
    position: relative;
    z-index: 1;
    border-radius: 12px;
    box-shadow: 0 18px 40px rgba(17, 17, 17, 0.12);
    padding: clamp(1.75rem, 4vw, 3rem);
    text-align: center;
  }

  .hero-title {
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    letter-spacing: 2px;
  }

  .hero-tagline {
    max-width: 62ch;
    margin: 1rem auto 1.75rem;
    color: var(--color-nav-texto);
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 600px) {
    .hero-card {
      margin-top: -56px;
    }
  }
</style>
