---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro:assets';
import cajon from '../assets/images/cajon.webp';
import firma from '../assets/images/firma.jpg';
import sala from '../assets/images/sala.webp';

interface Card {
  title: string;
  text: string;
  image: ImageMetadata;
  alt: string;
}

// Texts carried over from the current site (feature doc S3), typo fixed.
const cards: Card[] = [
  {
    title: 'Quiero Homenajear una Vida',
    text: 'Por tu tranquilidad, nos ocupamos de todo. Organizamos cada detalle del servicio para que vos solo te ocupes de recordar a tu ser querido.',
    image: cajon,
    alt: 'Ataúd y arreglo floral en una sala velatoria',
  },
  {
    title: 'Quiero Planificar a Futuro',
    text: 'Sabés que es un proceso difícil. Anticiparte con un plan de sepelio evita cargas económicas y organizativas a tu familia en el momento más delicado.',
    image: firma,
    alt: 'Firma de un contrato de plan de sepelio',
  },
  {
    title: 'Quiero ver las salas',
    text: 'Nuestras salas velatorias están preparadas para acompañar a las familias con comodidad, respeto y privacidad durante todo el servicio.',
    image: sala,
    alt: 'Sala velatoria acondicionada',
  },
];
---

<section class="section" id="nosotros" aria-labelledby="nosotros-title">
  <div class="container">
    <h2 id="nosotros-title" class="section-title">Nosotros</h2>
    <p class="section-subtitle">
      Tres formas de acompañarte: honrar, planificar y recibir.
    </p>

    <div class="cards-grid">
      {
        cards.map((c) => (
          <article class="card">
            <div class="card-media">
              <Image
                src={c.image}
                alt={c.alt}
                width={800}
                height={869}
                loading="lazy"
              />
            </div>
            <div class="card-body">
              <h3 class="card-title">{c.title}</h3>
              <p class="card-text">{c.text}</p>
              <a href="#contacto" class="btn btn--oliva card-btn">Ver más</a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .card {
    background: var(--color-crema);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 24px rgba(17, 17, 17, 0.08);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 32px rgba(17, 17, 17, 0.14);
  }

  .card-media img {
    width: 100%;
    height: 260px;
    object-fit: cover;
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
  }

  .card-title {
    color: var(--color-oliva-texto);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .card-text {
    color: var(--color-nav-texto);
    font-size: 0.95rem;
    flex: 1;
  }

  .card-btn {
    align-self: flex-start;
    padding: 0.6rem 1.8rem;
  }

  @media (max-width: 960px) {
    .cards-grid {
      grid-template-columns: 1fr;
      max-width: 520px;
      margin-inline: auto;
    }
  }
</style>
