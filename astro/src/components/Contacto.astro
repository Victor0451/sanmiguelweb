---
import { contact, FORMSPREE_ENDPOINT } from '../data/site';
---

<section class="section" id="contacto" aria-labelledby="contacto-title">
  <div class="container contacto-grid">
    <div class="contacto-info">
      <h2 id="contacto-title" class="section-title section-title--left">
        ¿Como Afiliarme?
      </h2>
      <p class="contacto-desc">
        Completá tu solicitud en línea y nos comunicaremos con vos a la
        brevedad, o escribinos directamente por WhatsApp.
      </p>

      <ul class="contacto-list">
        <li>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
          <a href={`tel:${contact.phoneHref}`}>{contact.phoneDisplay}</a>
        </li>
        <li>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
          <span>{contact.address.display}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm4.2 14.2L11 13V7h1.5v5.2l4.5 2.7z"/></svg>
          <span>{contact.hours}</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </li>
      </ul>

      <a href={contact.whatsapp} target="_blank" rel="noopener" class="btn btn--oliva contacto-wa">
        Escribinos por WhatsApp
      </a>
    </div>

    <div class="contacto-form-card">
      <!--
        Formspree static form (feature doc S6).
        TODO(forms): replace FORMSPREE_ENDPOINT placeholder in src/data/site.ts
        after registering the form at formspree.io with sanmiguelssociales@gmail.com.
      -->
      <form
        action={FORMSPREE_ENDPOINT}
        method="POST"
        class="contacto-form"
        data-contact-form
      >
        <div class="field">
          <label for="nombre">Nombre</label>
          <input
            id="nombre"
            name="nombre"
            type="text"
            placeholder="Tu nombre completo"
            required
            autocomplete="name"
          />
        </div>
        <div class="field">
          <label for="email">Mail</label>
          <input
            id="email"
            name="email"
            type="email"
            placeholder="tucorreo@ejemplo.com"
            required
            autocomplete="email"
          />
        </div>
        <div class="field">
          <label for="telefono">Tel</label>
          <input
            id="telefono"
            name="telefono"
            type="tel"
            placeholder="388 4XX-XXXX"
            required
            autocomplete="tel"
          />
        </div>
        <div class="field">
          <label for="mensaje">Consulta (opcional)</label>
          <textarea
            id="mensaje"
            name="mensaje"
            rows="3"
            placeholder="¿Por qué plan querés consultar?"
          ></textarea>
        </div>

        <button type="submit" class="btn btn--oliva form-submit">Enviar</button>

        <p class="form-status" data-form-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<script>
  // Submit via fetch so we can show an inline status without leaving the page.
  // Works with a real Formspree endpoint (Accept: application/json).
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status || !form) return;

    const action = form.action;
    if (action.includes('TODO_FORM_ID')) {
      status.textContent =
        'El formulario todavía no está configurado. Escribinos por WhatsApp o llamános.';
      status.className = 'form-status form-status--error';
      return;
    }

    const data = new FormData(form);
    status.textContent = 'Enviando…';
    status.className = 'form-status';
    try {
      const res = await fetch(action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (res.ok) {
        form.reset();
        status.textContent = '¡Gracias! Recibimos tu solicitud y te contactaremos pronto.';
        status.className = 'form-status form-status--ok';
      } else {
        status.textContent = 'Hubo un problema al enviar. Intentá nuevamente o escribinos por WhatsApp.';
        status.className = 'form-status form-status--error';
      }
    } catch {
      status.textContent = 'Sin conexión. Intentá nuevamente o escribinos por WhatsApp.';
      status.className = 'form-status form-status--error';
    }
  });
</script>

<style>
  .contacto-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .section-title--left {
    text-align: left;
  }

  .contacto-desc {
    color: var(--color-oliva-texto);
    margin-bottom: 1.75rem;
    max-width: 48ch;
  }

  .contacto-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.9rem;
    margin-bottom: 1.75rem;
  }

  .contacto-list li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-nav-texto);
  }

  .contacto-list svg {
    color: var(--color-verde-oscuro);
    flex-shrink: 0;
  }

  .contacto-list a {
    color: inherit;
    text-decoration: none;
  }

  .contacto-list a:hover,
  .contacto-list a:focus-visible {
    color: var(--color-verde-oscuro);
    text-decoration: underline;
  }

  .contacto-wa {
    padding: 0.75rem 2rem;
  }

  .contacto-form-card {
    background: var(--color-crema);
    border-radius: 12px;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    box-shadow: 0 8px 24px rgba(17, 17, 17, 0.08);
  }

  .contacto-form {
    display: grid;
    gap: 1.1rem;
  }

  .field {
    display: grid;
    gap: 0.35rem;
  }

  .field label {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--color-verde-oscuro);
  }

  .field input,
  .field textarea {
    border: 1px solid rgba(46, 47, 49, 0.25);
    border-radius: 8px;
    padding: 0.7rem 0.9rem;
    background: #ffffff;
    color: var(--color-texto);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    border-color: var(--color-verde-oscuro);
    box-shadow: 0 0 0 3px rgba(73, 113, 100, 0.2);
  }

  .form-submit {
    justify-self: start;
    padding: 0.75rem 2.6rem;
  }

  .form-status {
    font-size: 0.9rem;
    min-height: 1.2em;
  }

  .form-status--ok {
    color: var(--color-verde-oscuro);
  }

  .form-status--error {
    color: #a03030;
  }

  @media (max-width: 860px) {
    .contacto-grid {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .section-title--left {
      text-align: center;
    }

    .contacto-desc {
      text-align: center;
      margin-inline: auto;
    }

    .contacto-list {
      justify-items: center;
    }

    .contacto-info {
      text-align: center;
    }

    .contacto-wa {
      margin-inline: auto;
    }
  }
</style>
